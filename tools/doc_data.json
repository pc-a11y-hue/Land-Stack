 "model_card": {
  "model": "L2-regularised logistic regression (numpy, gradient descent)",
  "training_data": "4500 synthetic parcels; labels from a documented generating process + noise",
  "test_data": "1500 held-out synthetic parcels",
  "dispute_base_rate": 0.1582,
  "auc_test": 0.7406,
  "auc_rule_baseline": 0.6946,
  "precision_top_decile": 0.5333,
  "recall_top_decile": 0.3162,
  "features": [
   {
    "name": "reg_owner_mismatch",
    "label": "RoR vs Registration owner mismatch"
   },
   {
    "name": "tax_owner_mismatch",
    "label": "RoR vs Property Tax assessee mismatch"
   },
   {
    "name": "has_encumbrance",
    "label": "Existing mortgage / encumbrance"
   },
   {
    "name": "ownership_changes",
    "label": "Number of ownership changes on record"
   },
   {
    "name": "recent_transaction",
    "label": "Transaction within the last 12 months"
   },
   {
    "name": "tax_due",
    "label": "Property tax unpaid"
   },
   {
    "name": "unauthorized_change",
    "label": "Satellite: possible unauthorised construction"
   },
   {
    "name": "area_log",
    "label": "Plot size (log sq.m)"
   },
   {
    "name": "agri_land",
    "label": "Agricultural land use"
   }
  ],
  "learned_weights_standardised": {
   "reg_owner_mismatch": 0.567,
   "tax_owner_mismatch": 0.3085,
   "has_encumbrance": 0.273,
   "ownership_changes": 0.3477,
   "recent_transaction": 0.216,
   "tax_due": 0.124,
   "unauthorized_change": 0.2295,
   "area_log": 0.1395,
   "agri_land": 0.1449
  },
  "limitations": [
   "Trained on synthetic data — the AUC measures how well the model recovers the synthetic generating process, not real-world predictive power.",
   "The rule baseline scores lower partly because it ignores features the synthetic labels use; that gap would need to be re-measured on real case data.",
   "Risk scores are decision support for officers, never a basis for automated action.",
   "Features are limited to what the record layers contain; no personal or demographic data is used."
  ]
 },
