{
 "endpoints": [
  {
   "group": "Authentication",
   "method": "POST",
   "path": "/api/login/citizen",
   "access": "public",
   "summary": "Citizen login step 1: username + password, then an OTP is sent to the registered mobile"
  },
  {
   "group": "Authentication",
   "method": "POST",
   "path": "/api/login/citizen/verify",
   "access": "public",
   "summary": "Citizen login step 2: verify the OTP and start the session"
  },
  {
   "group": "Authentication",
   "method": "POST",
   "path": "/api/login/officer",
   "access": "public",
   "summary": "Officer login with username and password"
  },
  {
   "group": "Authentication",
   "method": "POST",
   "path": "/api/logout",
   "access": "public",
   "summary": "End the current session"
  },
  {
   "group": "Authentication",
   "method": "GET",
   "path": "/api/me",
   "access": "public",
   "summary": "Current session profile"
  },
  {
   "group": "Parcels & geometry",
   "method": "GET",
   "path": "/api/adapters",
   "access": "public",
   "summary": "State adapters: local record terms, area units and ingestion field mappings"
  },
  {
   "group": "Parcels & geometry",
   "method": "POST",
   "path": "/api/adapters/normalize",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Preview mapping a raw state-format record onto the canonical schema (nothing is saved)"
  },
  {
   "group": "Parcels & geometry",
   "method": "POST",
   "path": "/api/geo/check-boundary",
   "access": "officer: registration_officer",
   "summary": "Live validation for the drawing tool: shape, area, jurisdiction and overlap with registered plots"
  },
  {
   "group": "Parcels & geometry",
   "method": "GET",
   "path": "/api/my-properties",
   "access": "citizen",
   "summary": "Every parcel registered to the logged-in citizen, across all districts"
  },
  {
   "group": "Parcels & geometry",
   "method": "GET",
   "path": "/api/parcel/{ulpin}",
   "access": "public",
   "summary": "Full dossier for the owner or the district's officer; owner-name-only view for everyone else"
  },
  {
   "group": "Parcels & geometry",
   "method": "GET",
   "path": "/api/parcel/{ulpin}/bank",
   "access": "citizen",
   "summary": "Bank/loan details — visible to the owning citizen ONLY (not even the district officer)"
  },
  {
   "group": "Parcels & geometry",
   "method": "POST",
   "path": "/api/parcel/{ulpin}/link-bank",
   "access": "citizen",
   "summary": "Owner links a bank account (simulated verification)"
  },
  {
   "group": "Parcels & geometry",
   "method": "POST",
   "path": "/api/parcel/{ulpin}/privacy",
   "access": "citizen",
   "summary": "Owner chooses whether their name is publicly shown against this plot"
  },
  {
   "group": "Parcels & geometry",
   "method": "POST",
   "path": "/api/parcel/{ulpin}/unlink-bank",
   "access": "citizen",
   "summary": "Owner removes the bank link"
  },
  {
   "group": "Parcels & geometry",
   "method": "GET",
   "path": "/api/parcels",
   "access": "public",
   "summary": "GeoJSON FeatureCollection of parcels (base layer)"
  },
  {
   "group": "Parcels & geometry",
   "method": "GET",
   "path": "/api/parcels/district-defaults",
   "access": "officer: registration_officer",
   "summary": "Suggested values for the registration form — everything that repeats across a district"
  },
  {
   "group": "Parcels & geometry",
   "method": "POST",
   "path": "/api/parcels/register",
   "access": "officer: registration_officer",
   "summary": "Register a new parcel from a DRAWN boundary"
  },
  {
   "group": "Parcels & geometry",
   "method": "GET",
   "path": "/api/search",
   "access": "public",
   "summary": "Search by owner name, ULPIN or survey number"
  },
  {
   "group": "Sale deeds & people",
   "method": "GET",
   "path": "/api/deeds",
   "access": "any logged-in user",
   "summary": "Officers: deeds in their own district"
  },
  {
   "group": "Sale deeds & people",
   "method": "POST",
   "path": "/api/deeds",
   "access": "officer: registration_officer",
   "summary": "Draft a sale deed at the counter: names the parcel, the buyer and the agreed price; computes duty; sends OTPs"
  },
  {
   "group": "Sale deeds & people",
   "method": "GET",
   "path": "/api/deeds/{deed_id}",
   "access": "any logged-in user",
   "summary": "One deed with its full timeline"
  },
  {
   "group": "Sale deeds & people",
   "method": "POST",
   "path": "/api/deeds/{deed_id}/authenticate",
   "access": "officer: registration_officer",
   "summary": "The seller or buyer, present at the counter, reads out the OTP received on their mobile"
  },
  {
   "group": "Sale deeds & people",
   "method": "POST",
   "path": "/api/deeds/{deed_id}/cancel",
   "access": "officer: registration_officer",
   "summary": "Cancel a deed before it is registered"
  },
  {
   "group": "Sale deeds & people",
   "method": "POST",
   "path": "/api/deeds/{deed_id}/mutate",
   "access": "officer: revenue_officer",
   "summary": "Revenue Officer completes the mutation: RoR, ownership history and property-tax assessee move to the buyer"
  },
  {
   "group": "Sale deeds & people",
   "method": "POST",
   "path": "/api/deeds/{deed_id}/payment",
   "access": "officer: registration_officer",
   "summary": "Record the stamp-duty + registration-fee challan (payment gateway is simulated)"
  },
  {
   "group": "Sale deeds & people",
   "method": "POST",
   "path": "/api/deeds/{deed_id}/register",
   "access": "officer: registration_officer",
   "summary": "Registration Officer registers the deed"
  },
  {
   "group": "Sale deeds & people",
   "method": "POST",
   "path": "/api/deeds/{deed_id}/resend-otp",
   "access": "officer: registration_officer",
   "summary": "Re-issue the OTPs for parties who haven't authenticated yet"
  },
  {
   "group": "Sale deeds & people",
   "method": "POST",
   "path": "/api/persons",
   "access": "officer: registration_officer",
   "summary": "Create a person (identity + citizen login)"
  },
  {
   "group": "Sale deeds & people",
   "method": "GET",
   "path": "/api/persons/lookup",
   "access": "officer: registration_officer",
   "summary": "Find a person by name, username, person ID or mobile (needed to name a buyer or owner)"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/anomalies",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Dispute-risk view for the officer's district: rule-based score + learned model score with explanations"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/audit-log",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Most recent audit entries, newest first (each carries its chain hash)"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/audit-log/verify",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Recompute the hash chain over the whole audit log and report whether it is intact"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/demo/logins",
   "access": "public",
   "summary": "Demo mode only: sample officer and citizen logins for trying the prototype"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/health",
   "access": "public",
   "summary": "Liveness check"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/ml/model-card",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Model card for the risk model: data, metrics against the rule baseline, and limitations"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/parcel/{ulpin}/satellite",
   "access": "public",
   "summary": "Satellite change-detection result (owner or the district's officer)"
  },
  {
   "group": "Governance & analytics",
   "method": "POST",
   "path": "/api/parcel/{ulpin}/service-request",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Officer initiates a record-update request with the citizen present"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/regions",
   "access": "public",
   "summary": "The districts in the prototype"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/reports",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "District analytics for the logged-in officer"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/requests",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Record-update requests in the officer's own district"
  },
  {
   "group": "Governance & analytics",
   "method": "POST",
   "path": "/api/requests/{rid}/approve",
   "access": "officer: registration_officer",
   "summary": "Registration Officer approves"
  },
  {
   "group": "Governance & analytics",
   "method": "POST",
   "path": "/api/requests/{rid}/reject",
   "access": "officer: registration_officer",
   "summary": "Registration Officer rejects a pending request"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/satellite-image/{ulpin}/{stage}",
   "access": "public",
   "summary": "Synthetic before/after tile"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/satellite-watchlist",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Parcels under satellite watch in the officer's district"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/stats",
   "access": "public",
   "summary": "Headline counts"
  },
  {
   "group": "Governance & analytics",
   "method": "GET",
   "path": "/api/updates",
   "access": "any logged-in user",
   "summary": "Citizens: district-wide updates where they own land + updates addressed to their plots"
  },
  {
   "group": "Governance & analytics",
   "method": "POST",
   "path": "/api/updates",
   "access": "officer: revenue_officer, registration_officer, planning_officer",
   "summary": "Officer posts an announcement for their district, or for one plot"
  }
